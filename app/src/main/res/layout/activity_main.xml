<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <!-- Transcript -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="96dp"
        android:paddingBottom="220dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />
    </ScrollView>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="80dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plex_light"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="Put the phone on the table\nand tap to listen."
            android:textColor="@color/paper"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="Arabic and English are both understood.\nEach line is translated into the other."
            android:textColor="@color/mist"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/plex_light"
            android:gravity="center"
            android:text="ضع الهاتف على الطاولة واضغط للاستماع"
            android:textColor="@color/mist"
            android:textDirection="rtl"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Bottom fade so text slides under the controls -->
    <View
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="bottom"
        android:background="@drawable/fade_bottom"
        android:clickable="false"
        android:focusable="false" />

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/ink"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plex_semibold"
            android:text="Bayan"
            android:textColor="@color/paper"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/plex_medium"
            android:text="بيان"
            android:textColor="@color/sand"
            android:textSize="22sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnHistory"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Saved transcripts"
            android:src="@drawable/ic_history" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:src="@drawable/ic_tune" />
    </LinearLayout>

    <!-- Error banner -->
    <TextView
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="20dp"
        android:layout_marginTop="84dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/banner_bg"
        android:lineSpacingMultiplier="1.2"
        android:padding="14dp"
        android:textColor="@color/paper"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Shown when new lines arrive while scrolled up -->
    <TextView
        android:id="@+id/jump"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="214dp"
        android:background="@drawable/pill_bg"
        android:fontFamily="@font/plex_medium"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="Jump to latest"
        android:textColor="@color/paper"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/plex_medium"
            android:text="Tap to listen"
            android:textColor="@color/mist"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/usage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textColor="@color/mist"
            android:alpha="0.7"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Share transcript"
                android:src="@drawable/ic_share"
                android:visibility="invisible" />

            <com.mitesh.livetranslator.MicButton
                android:id="@+id/mic"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:contentDescription="Start or stop listening" />

            <ImageButton
                android:id="@+id/btnNew"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Start a new transcript"
                android:src="@drawable/ic_new"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>

    <!-- Full-screen view of one line, to show across the table -->
    <LinearLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ink"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/stageTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plex_medium"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/paper"
            android:textSize="38sp" />

        <TextView
            android:id="@+id/stageSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/plex_light"
            android:lineSpacingMultiplier="1.3"
            android:textColor="@color/mist"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/stagePlay"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/pill_bg"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/ic_play"
            android:fontFamily="@font/plex_medium"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="22dp"
            android:text="Play aloud"
            android:textColor="@color/paper"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:text="Tap anywhere to close"
            android:textColor="@color/mist"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
