        <item name="colorAccent">@color/sand</item>
        <item name="colorControlActivated">@color/sand</item>
        <item name="colorControlNormal">@color/mist</item>
        <item name="android:textColorPrimary">@color/paper</item>
        <item name="android:textColorHint">@color/mist</item>
        <item name="android:fontFamily">@font/plex_regular</item>
        <item name="fontFamily">@font/plex_regular</item>
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
