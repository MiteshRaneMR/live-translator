    <color name="dusk">#1F2440</color>
    <color name="line">#2C3254</color>
    <color name="mist">#8F95AE</color>
    <color name="paper">#ECEEF4</color>
    <color name="sand">#D8B26A</color>
    <color name="sand_dim">#33D8B26A</color>
