<resources>
    <style name="Bayan.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/plex_medium</item>
        <item name="android:textColor">@color/paper</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Bayan.Hint" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textColor">@color/mist</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Bayan.Field" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:fontFamily">@font/plex_regular</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/paper</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
